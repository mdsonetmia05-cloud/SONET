# Copy to .env.local and fill in real values. Never commit .env.local.
# Database — Neon (Postgres). Pooled connection string from the Neon dashboard.
DATABASE_URL=postgresql://user:password@ep-xxx-ap-southeast-1.aws.neon.tech/sonet-ecosystem?sslmode=require
# Auth — Neon Auth (Managed Better Auth). Base URL from Neon console
# Settings → Better Auth; cookie secret generated with: openssl rand -base64 32
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=
# AI providers — server-side only, never NEXT_PUBLIC_*
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
